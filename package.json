{
  "name": "mycelia",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "build:wasm": "wasm-pack build crates/mycelia-core --target web --out-dir ../../pkg/mycelia-core",
    "test": "vitest run",
    "test:wasm": "cargo test --workspace",
    "lint": "tsc --noEmit",
    "format": "prettier --write src/"
  },
  "devDependencies": {
    "@types/simple-peer": "^9.11.9",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "simple-peer": "^9.11.0",
    "three": "^0.168.0",
    "ws": "^8.18.0"
  }
}
